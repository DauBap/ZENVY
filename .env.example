# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── JWT Auth ─────────────────────────────────────────────────────────────────
# Dùng để ký/verify access token. Tạo random string mạnh, ít nhất 32 ký tự.
# Ví dụ: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-at-least-32-chars"

# ── App URL (dùng cho reset password link + PayOS return/cancel URL) ─────────
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# ── PayOS (cổng thanh toán) ──────────────────────────────────────────────────
# Lấy tại https://my.payos.vn → Kênh thanh toán → Thông tin xác thực API
PAYOS_CLIENT_ID="your-payos-client-id"
PAYOS_API_KEY="your-payos-api-key"
PAYOS_CHECKSUM_KEY="your-payos-checksum-key"
