# ═══════════════════════════════════════════════════════════════
#  ZENVY — Environment Variables Template
#  Copy file này thành .env và điền đầy đủ trước khi chạy local.
#  Khi deploy Vercel: copy từng dòng vào Settings > Environment Variables.
# ═══════════════════════════════════════════════════════════════

# ── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Lấy từ: https://console.neon.tech → Project → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── JWT Authentication ───────────────────────────────────────────────────────
# Tạo bằng: openssl rand -base64 32   (ít nhất 32 ký tự, giữ bí mật tuyệt đối)
JWT_SECRET="your-super-secret-jwt-key-at-least-32-chars"

# ── App URL ──────────────────────────────────────────────────────────────────
# Local: http://localhost:3000   |   Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# ── Email (Gmail SMTP — dùng để gửi thông báo booking, reset password) ───────
# Bật App Password tại: https://myaccount.google.com/apppasswords
EMAIL_USER="your-gmail@gmail.com"
EMAIL_PASSWORD="your-gmail-app-password-16-chars"

# ── Admin ────────────────────────────────────────────────────────────────────
# Email nhận thông báo booking mới từ hệ thống
ADMIN_EMAIL="admin@your-domain.com"

# ── Web Push Notifications (VAPID) ───────────────────────────────────────────
# Tạo cặp key bằng: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_MAILTO="mailto:admin@your-domain.com"

# ── OpenAI (AI Tarot feature) ─────────────────────────────────────────────────
# Lấy từ: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
